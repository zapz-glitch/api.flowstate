{
  "name": "@flowstate-api/db",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply flowstate-api-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply flowstate-api-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@noble/hashes": "^1.6.0",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.7.0",
    "wrangler": "^3.80.0"
  }
}
